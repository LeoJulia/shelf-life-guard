# Публичные переменные Supabase (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Секретный ключ Admin API (server-side only, никогда не в NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# E-mail владельцев, которым доступен /invites (через запятую)
INVITE_ADMIN_EMAILS=

# Прод-URL (используется в шаблонах писем и редиректах)
SITE_URL=
